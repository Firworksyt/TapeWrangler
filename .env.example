# Copy to .env and fill in.

# Required. Anything that changes the catalog (CLI uploads, edits in the web UI)
# must present this token. Generate one with:  openssl rand -hex 24
TAPEWRANGLER_TOKEN=

# Host port for the web UI and API.
PORT=3000

# Automatic database backups go to data/backups/.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
